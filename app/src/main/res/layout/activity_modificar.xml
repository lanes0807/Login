
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="25dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TODO list"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#399E5A"
            android:gravity="center"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modificar cuenta"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="25dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nuevo correo electrónico"
            android:textColor="#000000"/>

        <EditText
            android:id="@+id/txtNuevoCorreo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Nuevo correo"
            android:inputType="textEmailAddress"
            android:textSize="14sp"
            android:backgroundTint="#399E5A"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nueva contraseña"
            android:textColor="#000000"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/txtNuevaContrasena"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Nueva contraseña"
            android:inputType="textPassword"
            android:textSize="14sp"
            android:backgroundTint="#399E5A"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmar contraseña"
            android:textColor="#000000"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/txtConfirmarContrasena"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Confirmar contraseña"
            android:inputType="textPassword"
            android:textSize="14sp"
            android:backgroundTint="#399E5A"/>

        <Button
            android:id="@+id/btnGuardarCambios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar cambios"
            android:textColor="#FFFFFF"
            android:backgroundTint="#399E5A"
            android:layout_marginTop="35dp"/>

        <Button
            android:id="@+id/btnCancelarCambios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:textColor="#399E5A"
            android:backgroundTint="#E8F5E9"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
